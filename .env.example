# ---- Public (browser-visible) configuration ----
# Where the contact form POSTs. Leave unset to keep the form in "preview" mode
# (submission disabled, honest notice shown). Example for the bundled serverless
# function: /api/contact
VITE_CONTACT_ENDPOINT=

# Where the "Test Your Idea" intake wizard POSTs. Leave unset to keep the wizard in
# preview mode (submission disabled, honest notice shown). Example: /api/study
VITE_STUDY_ENDPOINT=

# Production origin used for canonical URLs, sitemap and robots.
# Preview builds should leave this unset so they are generated as noindex.
VITE_SITE_ORIGIN=https://savantanalytics.net

# Set to "true" ONLY for the production deploy. Anything else emits noindex.
VITE_INDEXABLE=false

# ---- Server-only secrets (NEVER prefix with VITE_) ----
# Used by api/contact.ts. Keep these in the hosting provider's secret store.
# Verified recipient inbox for inquiries (owner must confirm and test receipt).
CONTACT_TO=
# Sending address on a domain verified with your email provider.
CONTACT_FROM=
# Resend API key (https://resend.com) — only if the owner approves Resend as the processor.
RESEND_API_KEY=

# ---- Test Your Idea (api/study.ts) ----
# Inbox that receives new research requests. Falls back to CONTACT_TO when unset.
STUDY_TO=
# Optional fixed turnaround shown in the prospect confirmation email, e.g. "within 48 business hours".
# Leave unset until operations confirm; the site then says delivery time is confirmed by email.
STUDY_TURNAROUND=
