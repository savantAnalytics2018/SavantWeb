{
  // Cloudflare Workers config: static site from ./dist + the /api/contact endpoint.
  // Build: `npm run build`  ·  Deploy: `npx wrangler deploy`
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savantweb",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Run the site build before deploying, so the dashboard build command can stay empty.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // Run the Worker before the asset lookup for the research front door ("/", "/start") and the API
    // endpoints ("/api/*" — otherwise a missing asset returns the static 404 page). See docs/SUBDOMAIN.md.
    // Research subdomain front door: let the Worker rewrite "/" and "/start" before the asset
    // lookup (otherwise the static index.html / 404 are served first). See docs/SUBDOMAIN.md.
    "run_worker_first": ["/", "/start", "/start/*", "/api/*"]
  },
  "observability": { "enabled": true }
}
