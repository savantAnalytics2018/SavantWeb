{
  // TEST deployment of the site as a SECOND Worker ("savantweb-test").
  // It never touches the production Worker ("savantweb") or savantanalytics.net.
  // Deploy command for the test Worker: `npx wrangler deploy --config wrangler.test.jsonc`
  // Full setup: docs/DEPLOY-TEST-WORKER.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savantweb-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // Run the Worker before the asset lookup for the research front door ("/", "/start") and the API
    // endpoints ("/api/*" — otherwise a missing asset returns the static 404 page). See docs/SUBDOMAIN.md.
    // Research subdomain front door: let the Worker rewrite "/" and "/start" before the asset
    // lookup (otherwise the static index.html / 404 are served first). See docs/SUBDOMAIN.md.
    "run_worker_first": ["/", "/start", "/start/*", "/s", "/s/*", "/admin", "/twin-detail/s/*", "/api/*"]
  },
  // Non-secret runtime variables. PORTAL_ORIGIN is the host used in the portal's emailed links.
  "vars": { "PORTAL_ORIGIN": "https://twindetail.savantanalytics.net" },
  "observability": { "enabled": true },
  // Paid-study client portal (docs/PORTAL.md). Both bindings are optional: without DB the portal
  // routes return 503 and the Decision Study questionnaire falls back to email-only.
  //   1. npx wrangler d1 create savantweb-portal --config wrangler.test.jsonc   → paste database_id below
  //   2. npx wrangler d1 execute savantweb-portal --remote --file=db/portal.sql --config wrangler.test.jsonc
  //   3. npx wrangler r2 bucket create savantweb-reports
  "d1_databases": [{ "binding": "DB", "database_name": "savantweb-portal", "database_id": "13dc0ee3-b621-4261-a5d7-685c9580c30d" }],
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "savantweb-reports" }]
}
